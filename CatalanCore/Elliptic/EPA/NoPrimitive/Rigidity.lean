module

public import CatalanCore.Elliptic.EPA.NoPrimitive.Finite
public import OAI.NumberTheory.PiExponent.LocalAlgebra.TranscendenceBasisReduction
public import Mathlib.FieldTheory.IsAlgClosed.Basic
public import Mathlib.FieldTheory.Perfect

/-!
# Projection rigidity (CM `thm:origin-projection-rigidity`)

Let `E/C` be an essentially finite type field extension (`C` of characteristic zero), `F ∈ C[X]`
squarefree of degree `≥ 2`, `u, t, z ∈ E` with `t² = F(u)`, `F'(u) ≠ 0` and `dz = -F'(u)⁻¹ dt`
in `Ω[E⁄C]`.  Then `u` and `t` are algebraic over `C` (constant if `C` is algebraically closed).

Paper proof (CM l.1716-1765).  If `u` were transcendental, extend it to a transcendence basis and
let `K'` be generated by the other basis elements (`exists_intermediateField_finite_over_simple`,
OAI): `u` is transcendental over `K'` and `E` is finite over `K'(u)`.  Every `K'`-derivation of `E`
is a `C`-derivation, so `dz = -F'(u)⁻¹ dt` holds for it; differentiating `t² = F(u)` gives
`2 t dt = F'(u) du`, hence `du = 2 t d(-z)`.  Now `K'(u) ≅ K'(X)` and `F` squarefree over `C`
stays squarefree over `K'` (characteristic zero); this contradicts `no_finite_primitive_deriv`.
-/

@[expose] public section

namespace CatalanCore.Elliptic.EPA

open Polynomial Module IntermediateField

variable {C E : Type*} [Field C] [CharZero C] [Field E] [Algebra C E]

/-- `no_finite_primitive_deriv` over an intermediate field `K'` with `E` finite over `K'(u)`. -/
theorem no_primitive_over_subfield (K' : IntermediateField C E) {u : E}
    (hu : Transcendental K' u) [FiniteDimensional K'⟮u⟯ E]
    {F : C[X]} (hF : Squarefree F) (hd : 2 ≤ F.natDegree) {t z : E}
    (ht : t ^ 2 = aeval u F) :
    ¬ ∀ D : Derivation K' E E, D u = 2 * t * D z := by
  classical
  let e := RatFunc.algEquivOfTranscendental u hu
  letI : Algebra (RatFunc K') E :=
    ((K'⟮u⟯).val.toRingHom.comp e.toRingEquiv.toRingHom).toAlgebra
  haveI : IsScalarTower K' (RatFunc K') E := IsScalarTower.of_algebraMap_eq (fun c => by
    have := e.commutes c
    change algebraMap K' E c = (K'⟮u⟯).val (e (algebraMap K' (RatFunc K') c))
    rw [this]; rfl)
  haveI : CharZero K' := charZero_of_injective_algebraMap (algebraMap C K').injective
  haveI : FiniteDimensional (RatFunc K') E := by
    letI : Algebra (RatFunc K') K'⟮u⟯ := e.toRingEquiv.toRingHom.toAlgebra
    haveI : IsScalarTower (RatFunc K') K'⟮u⟯ E := IsScalarTower.of_algebraMap_eq (fun f => rfl)
    haveI : Module.Finite (RatFunc K') K'⟮u⟯ :=
      Module.Finite.of_surjective (Algebra.linearMap (RatFunc K') K'⟮u⟯) e.surjective
    exact Module.Finite.trans K'⟮u⟯ E
  have hxu : xE K' E = u := by
    change (K'⟮u⟯).val (e RatFunc.X) = u
    exact RatFunc.algEquivOfTranscendental_X u hu
  have hF' : Squarefree (F.map (algebraMap C K')) := by
    have : F.Separable := PerfectField.separable_iff_squarefree.2 hF
    exact PerfectField.separable_iff_squarefree.1 (this.map)
  have hd' : 2 ≤ (F.map (algebraMap C K')).natDegree := by
    rw [natDegree_map]; exact hd
  have hy : t ^ 2 = aeval (xE K' E) (F.map (algebraMap C K')) := by
    rw [hxu, aeval_map_algebraMap]
    exact ht
  have := no_finite_primitive_deriv (C := K') (E := E) hF' hd' (z := z) hy
  rw [hxu] at this
  exact this

omit [CharZero C] in
/-- An element algebraic over an algebraically closed field is constant. -/
theorem exists_algebraMap_eq_of_isAlgebraic [IsAlgClosed C] {x : E} (hx : IsAlgebraic C x) :
    ∃ c : C, algebraMap C E c = x := by
  have hint : IsIntegral C x := hx.isIntegral
  have hq : (minpoly C x).leadingCoeff = 1 := minpoly.monic hint
  have h : (minpoly C x).degree = 1 :=
    IsAlgClosed.degree_eq_one_of_irreducible C (minpoly.irreducible hint)
  have h0 : aeval x (minpoly C x) = 0 := minpoly.aeval C x
  rw [eq_X_add_C_of_degree_eq_one h, hq, C_1, one_mul, aeval_add, aeval_X, aeval_C,
    add_eq_zero_iff_eq_neg] at h0
  exact ⟨-(minpoly C x).coeff 0, by rw [map_neg]; exact h0.symm⟩

omit [CharZero C] in
/-- If `u` is algebraic and `t² = F(u)` then `t` is algebraic. -/
theorem isAlgebraic_of_sq {F : C[X]} {u t : E} (hu : IsAlgebraic C u) (ht : t ^ 2 = aeval u F) :
    IsAlgebraic C t := by
  have hint : IsIntegral C u := hu.isIntegral
  haveI : Algebra.IsIntegral C (Algebra.adjoin C {u}) :=
    Algebra.IsIntegral.adjoin (fun x hx => by rw [Set.mem_singleton_iff.1 hx]; exact hint)
  have hmem : aeval u F ∈ Algebra.adjoin C {u} := aeval_mem_adjoin_singleton C u
  have h1 : IsIntegral C (⟨aeval u F, hmem⟩ : Algebra.adjoin C {u}) :=
    Algebra.IsIntegral.isIntegral _
  have h2 : IsIntegral C (aeval u F) := by simpa using h1.map (Algebra.adjoin C {u}).val
  exact IsAlgebraic.of_pow two_pos (by rw [ht]; exact h2.isAlgebraic)

/-- **Projection rigidity** (CM l.1716), the form used in E09.5d: `u` and `t` are algebraic. -/
theorem isAlgebraic_of_quartic_differential [Algebra.EssFiniteType C E]
    (F : C[X]) (hF : Squarefree F) (hd : 2 ≤ F.natDegree) (u t z : E)
    (ht : t ^ 2 = aeval u F) (hJ : aeval u (derivative F) ≠ 0)
    (hz : KaehlerDifferential.D C E z =
      -(aeval u (derivative F))⁻¹ • KaehlerDifferential.D C E t) :
    IsAlgebraic C u ∧ IsAlgebraic C t := by
  have hu : IsAlgebraic C u := by
    by_contra hnot
    have htr : Transcendental C u := hnot
    obtain ⟨K', hK', hfin⟩ := OAI.PiExponent.exists_intermediateField_finite_over_simple C E htr
    refine no_primitive_over_subfield K' hK' hF hd (z := -z) ht ?_
    intro D'
    let D : Derivation C E E := D'.restrictScalars C
    have hDz : D z = -(aeval u (derivative F))⁻¹ * D t := by
      have := congrArg D.liftKaehlerDifferential hz
      rw [Derivation.liftKaehlerDifferential_comp_D, map_smul,
        Derivation.liftKaehlerDifferential_comp_D, smul_eq_mul] at this
      exact this
    have hDt : 2 * t * D t = aeval u (derivative F) * D u := by
      have h1 := D.map_aeval F u
      have h2 : D (t ^ 2) = 2 * t * D t := by
        rw [Derivation.leibniz_pow]; simp only [smul_eq_mul, nsmul_eq_mul]; push_cast; ring
      rw [ht, h1, smul_eq_mul] at h2
      exact h2.symm
    have hu' : D' u = D u := rfl
    have hz' : D' z = D z := rfl
    rw [hu', show D' (-z) = -D' z from map_neg D' z, hz', hDz]
    field_simp
    linear_combination (-1 : E) * hDt
  exact ⟨hu, isAlgebraic_of_sq hu ht⟩

/-- Over an algebraically closed field, `u` and `t` are constants. -/
theorem constant_of_quartic_differential [IsAlgClosed C] [Algebra.EssFiniteType C E]
    (F : C[X]) (hF : Squarefree F) (hd : 2 ≤ F.natDegree) (u t z : E)
    (ht : t ^ 2 = aeval u F) (hJ : aeval u (derivative F) ≠ 0)
    (hz : KaehlerDifferential.D C E z =
      -(aeval u (derivative F))⁻¹ • KaehlerDifferential.D C E t) :
    ∃ c₀ c₁ : C, algebraMap C E c₀ = u ∧ algebraMap C E c₁ = t := by
  obtain ⟨h1, h2⟩ := isAlgebraic_of_quartic_differential F hF hd u t z ht hJ hz
  obtain ⟨c₀, hc₀⟩ := exists_algebraMap_eq_of_isAlgebraic h1
  obtain ⟨c₁, hc₁⟩ := exists_algebraMap_eq_of_isAlgebraic h2
  exact ⟨c₀, c₁, hc₀, hc₁⟩

/-- The same for `dz = -(2t)⁻¹ du`, `t ≠ 0` (CM l.1727). -/
theorem isAlgebraic_of_quartic_differential' [Algebra.EssFiniteType C E]
    (F : C[X]) (hF : Squarefree F) (hd : 2 ≤ F.natDegree) (u t z : E)
    (ht : t ^ 2 = aeval u F) (ht0 : t ≠ 0)
    (hz : KaehlerDifferential.D C E z = -(2 * t)⁻¹ • KaehlerDifferential.D C E u) :
    IsAlgebraic C u ∧ IsAlgebraic C t := by
  have hu : IsAlgebraic C u := by
    by_contra hnot
    have htr : Transcendental C u := hnot
    obtain ⟨K', hK', hfin⟩ := OAI.PiExponent.exists_intermediateField_finite_over_simple C E htr
    refine no_primitive_over_subfield K' hK' hF hd (z := -z) ht ?_
    intro D'
    let D : Derivation C E E := D'.restrictScalars C
    have hDz : D z = -(2 * t)⁻¹ * D u := by
      have := congrArg D.liftKaehlerDifferential hz
      rw [Derivation.liftKaehlerDifferential_comp_D, map_smul,
        Derivation.liftKaehlerDifferential_comp_D, smul_eq_mul] at this
      exact this
    have hu' : D' u = D u := rfl
    have hz' : D' z = D z := rfl
    have : CharZero E := charZero_of_injective_algebraMap (algebraMap C E).injective
    rw [hu', show D' (-z) = -D' z from map_neg D' z, hz', hDz]
    field_simp
  exact ⟨hu, isAlgebraic_of_sq hu ht⟩

end CatalanCore.Elliptic.EPA
