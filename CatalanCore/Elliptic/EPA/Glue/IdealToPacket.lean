module

public import CatalanCore.Elliptic.EPA.Jet
public import CatalanCore.Elliptic.EPA.Geo.CentreIdeal
public import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# From the centre ideal to packets (row E09.11, part 1)

Labels refer to the proof design (§2 P1, §5 E09.11) and CM l.3473--3537. Template: OpenAI
(Apache-2.0, openai/math fd4aeeb2) `Jets/AffineJetPackets.lean` (`formalJet_packets_surjective`,
`packets_surjective_of_polynomialIdeal_quotient`), with the log series replaced by the chart series
`U`, `L` and the logarithmic centre ideal by `Geo.centreIdealPt`.

Notation: `jetIdeal W H = j_H` is the ideal of series in `ℂ⟦T, V₁, …, V_m⟧` all of whose coefficients of
jet weight `< H` vanish (`rationalWeightedIdeal (jetWt W)`).

* `ellJet_pow_le`: `Φ_c(I_c^n) ⊆ j_{nD}` (P1; the generators `t^a, u^a, f, (Z_i − c_i − L_{<T₀}(t))^{b_i}`
  map into `j_D`).
* `reach_all`: for every series `F`, some polynomial `P` has `Φ_c(P) ≡ F` modulo `j_{nD}` (the quotient
  is finite-dimensional and generated by `T = Φ_c(t)` and `V_i ≡ Φ_c(Z_i − c_i − L_{<na}(t))`).
* `centreIdealPt_isCoprime`: the ideals `I_{c₀}, I_{c₁}` of distinct centres are comaximal.
* `quotient_to_packets_surjective`: a family `f a ∈ ℂ[u,t,Z]` surjecting onto `ℂ[u,t,Z]/J^n`
  surjects onto the product of the packets (Chinese remainder theorem).
-/

@[expose] public section

namespace CatalanCore.Elliptic.EPA

namespace Glue

open CatalanCore.Elliptic OAI.PiExponent OAI.PiExponent.JetGeometry

variable {m K : ℕ} {W : Weights m} {σ : ℚ} {ch : OriginChart}

/-! ### The jet ideals -/

theorem jetWt_nonneg (W : Weights m) (i : Fin (m + 1)) : 0 ≤ jetWt W i :=
  (Geo.jetWt_pos W i).le

/-- `j_H`: the series whose coefficients of jet weight `< H` vanish. -/
noncomputable abbrev jetIdeal (W : Weights m) (H : ℚ) : Ideal (MvPowerSeries (Fin (m + 1)) ℂ) :=
  rationalWeightedIdeal (jetWt W) (jetWt_nonneg W) H

theorem mem_jetIdeal {H : ℚ} {f : MvPowerSeries (Fin (m + 1)) ℂ} :
    f ∈ jetIdeal W H ↔ ∀ d, Finsupp.weight (jetWt W) d < H → MvPowerSeries.coeff d f = 0 :=
  Iff.rfl

/-- The `i`-th coordinate times its jet weight is at most the weight. -/
theorem weight_coord_le (W : Weights m) (d : Fin (m + 1) →₀ ℕ) (i : Fin (m + 1)) :
    jetWt W i * (d i : ℚ) ≤ Finsupp.weight (jetWt W) d := by
  rw [Finsupp.weight_eq_sum]
  calc jetWt W i * (d i : ℚ) = d i • jetWt W i := by rw [nsmul_eq_mul, mul_comm]
    _ ≤ ∑ j, d j • jetWt W j :=
      Finset.single_le_sum (f := fun j => d j • jetWt W j)
        (fun j _ => nsmul_nonneg (jetWt_nonneg W j) _) (Finset.mem_univ i)

/-- If `v₀ t = H`, a monomial of weight `< H` has `T`-exponent `< t`. -/
theorem d_zero_lt (W : Weights m) {t : ℕ} {H : ℚ} (hH : W.v₀ * (t : ℚ) = H)
    {d : Fin (m + 1) →₀ ℕ} (hd : Finsupp.weight (jetWt W) d < H) : d 0 < t := by
  by_contra h
  push_neg at h
  have h1 : (t : ℚ) ≤ (d 0 : ℚ) := by exact_mod_cast h
  have h2 := weight_coord_le W d 0
  rw [jetWt_zero] at h2
  have h3 : W.v₀ * (t : ℚ) ≤ W.v₀ * (d 0 : ℚ) := mul_le_mul_of_nonneg_left h1 W.v₀_pos.le
  linarith

/-! ### `Us`, `Ls` and the truncation of `L` -/

theorem Us_const (s : OriginSeries ch) : PowerSeries.constantCoeff (Us s) = 0 := by
  rw [← PowerSeries.coeff_zero_eq_constantCoeff_apply]
  simp only [Us, PowerSeries.coeff_map, PowerSeries.coeff_zero_eq_constantCoeff_apply, s.U_zero,
    map_zero]

theorem coeff_Us_pow_eq_zero (s : OriginSeries ch) {a n : ℕ} (hn : n < a) :
    PowerSeries.coeff n (Us s ^ a) = 0 := by
  obtain ⟨g, hg⟩ := PowerSeries.X_dvd_iff.mpr (Us_const s)
  rw [hg, mul_pow, PowerSeries.coeff_X_pow_mul', if_neg (by omega)]

/-- `Σ_{k<T} [T^k]L · T^k` over `ℂ`. -/
noncomputable def LsTrunc (s : OriginSeries ch) (T : ℕ) : PowerSeries ℂ :=
  ∑ k ∈ Finset.range T, PowerSeries.C (PowerSeries.coeff k (Ls s)) * PowerSeries.X ^ k

theorem coeff_LsTrunc (s : OriginSeries ch) (T n : ℕ) :
    PowerSeries.coeff n (LsTrunc s T) = if n < T then PowerSeries.coeff n (Ls s) else 0 := by
  unfold LsTrunc
  rw [map_sum]
  simp only [PowerSeries.coeff_C_mul_X_pow, Finset.sum_ite_eq, Finset.mem_range]

theorem ellJet_C (s : OriginSeries ch) (c : Fin m → ℂ) (a : ℂ) :
    ellJet s c (MvPolynomial.C a : AmbRing m) = MvPowerSeries.C a := by
  simp [ellJet, MvPowerSeries.algebraMap_apply]

theorem ellJet_truncL (s : OriginSeries ch) (c : Fin m → ℂ) (T : ℕ) :
    ellJet s c (Geo.truncL s T : AmbRing m) = liftSeries m (LsTrunc s T) := by
  unfold Geo.truncL LsTrunc
  rw [map_sum, map_sum]
  refine Finset.sum_congr rfl fun k _ => ?_
  simp only [map_mul, map_pow, ellJet_tV, liftSeries_X, liftSeries_C, ellJet_C]
  have hk : PowerSeries.coeff k (Ls s) = ((PowerSeries.coeff k s.L : ℚ) : ℂ) := by
    simp [Ls, PowerSeries.coeff_map]
  rw [hk]

/-- `Φ_c(Z_i − c_i − L_{<T}(t)) = V_i + (L − L_{<T})(T)`. -/
theorem ellJet_zgen (s : OriginSeries ch) (c : Fin m → ℂ) (T : ℕ) (i : Fin m) :
    ellJet s c (zV i - MvPolynomial.C (c i) - Geo.truncL s T) =
      MvPowerSeries.X i.succ + liftSeries m (Ls s - LsTrunc s T) := by
  simp only [map_sub, ellJet_zV, ellJet_C, ellJet_truncL]
  ring

/-! ### The generators of `I_{c₀}` map into `j_D` -/

theorem X_zero_pow_mem (sc : Geo.EpaScale W σ) :
    (MvPowerSeries.X (0 : Fin (m + 1)) : MvPowerSeries (Fin (m + 1)) ℂ) ^ sc.a ∈
      jetIdeal W (sc.D : ℚ) := by
  rw [mem_jetIdeal]
  intro d hd
  rw [MvPowerSeries.coeff_X_pow]
  split_ifs with h
  · exfalso
    subst h
    rw [Finsupp.weight_single, nsmul_eq_mul, jetWt_zero] at hd
    linarith [sc.a_eq, mul_comm (sc.a : ℚ) W.v₀]
  · rfl

theorem Us_pow_mem (sc : Geo.EpaScale W σ) (s : OriginSeries ch) :
    (liftSeries m (Us s)) ^ sc.a ∈ jetIdeal W (sc.D : ℚ) := by
  rw [mem_jetIdeal]
  intro d hd
  rw [← map_pow (liftSeries m), coeff_liftSeries]
  split_ifs with h
  · exact coeff_Us_pow_eq_zero s (d_zero_lt W sc.a_eq hd)
  · rfl

theorem Zgen_mem_succ (sc : Geo.EpaScale W σ) (s : OriginSeries ch) (i : Fin m) :
    (MvPowerSeries.X i.succ + liftSeries m (Ls s - LsTrunc s sc.T₀) :
      MvPowerSeries (Fin (m + 1)) ℂ) ∈ jetIdeal W (jetWt W i.succ) := by
  rw [mem_jetIdeal]
  intro d hd
  have h1 : d ≠ Finsupp.single i.succ 1 := by
    rintro rfl
    rw [Finsupp.weight_single, one_smul] at hd
    exact lt_irrefl _ hd
  rw [map_add, MvPowerSeries.coeff_X, if_neg h1, zero_add, coeff_liftSeries]
  split_ifs with ht
  · rw [map_sub, coeff_LsTrunc]
    by_cases h0 : d 0 < sc.T₀
    · rw [if_pos h0, sub_self]
    · exfalso
      push_neg at h0
      have h2 := weight_coord_le W d 0
      rw [jetWt_zero] at h2
      have h3 := sc.T₀_gt i
      have h4 : (sc.T₀ : ℚ) ≤ (d 0 : ℚ) := by exact_mod_cast h0
      have h5 : W.v₀ * (sc.T₀ : ℚ) ≤ W.v₀ * (d 0 : ℚ) :=
        mul_le_mul_of_nonneg_left h4 W.v₀_pos.le
      rw [jetWt_succ] at hd
      linarith [mul_comm (sc.T₀ : ℚ) W.v₀]
  · rfl

theorem Zgen_pow_mem (sc : Geo.EpaScale W σ) (s : OriginSeries ch) (i : Fin m) :
    (MvPowerSeries.X i.succ + liftSeries m (Ls s - LsTrunc s sc.T₀) :
      MvPowerSeries (Fin (m + 1)) ℂ) ^ sc.b i ∈ jetIdeal W (sc.D : ℚ) := by
  have hx := Zgen_mem_succ sc s i
  have hle : Ideal.span {(MvPowerSeries.X i.succ + liftSeries m (Ls s - LsTrunc s sc.T₀) :
      MvPowerSeries (Fin (m + 1)) ℂ)} ≤ jetIdeal W (jetWt W i.succ) := by
    rw [Ideal.span_le, Set.singleton_subset_iff]
    exact hx
  have hp := ideal_pow_le_rationalWeightedIdeal (jetWt W) (jetWt_nonneg W) _ (jetWt W i.succ) hle
    (sc.b i)
  have hb : ((sc.b i : ℕ) : ℚ) * jetWt W i.succ = (sc.D : ℚ) := by
    rw [mul_comm, jetWt_succ]
    exact sc.b_eq i
  rw [hb] at hp
  exact hp (Ideal.pow_mem_pow (Ideal.mem_span_singleton_self _) _)

theorem ellJet_gens_mem (sc : Geo.EpaScale W σ) (s : OriginSeries ch) (c₀ : Fin m → ℂ) :
    ∀ g ∈ Geo.centreGens sc s c₀, ellJet s c₀ g ∈ jetIdeal W (sc.D : ℚ) := by
  rintro g (hg | ⟨i, rfl⟩)
  · rcases hg with rfl | rfl | rfl
    · rw [map_pow, ellJet_tV]
      exact X_zero_pow_mem sc
    · rw [map_pow, ellJet_uV]
      exact Us_pow_mem sc s
    · rw [ellJet_relation]
      exact zero_mem _
  · rw [map_pow, ellJet_zgen]
    exact Zgen_pow_mem sc s i

theorem map_centreIdealPt_le (sc : Geo.EpaScale W σ) (s : OriginSeries ch) (c₀ : Fin m → ℂ) :
    Ideal.map (ellJet s c₀) (Geo.centreIdealPt sc s c₀) ≤ jetIdeal W (sc.D : ℚ) := by
  rw [Geo.centreIdealPt, Ideal.map_span, Ideal.span_le]
  rintro _ ⟨g, hg, rfl⟩
  exact ellJet_gens_mem sc s c₀ g hg

/-- P1: `Φ_c(I_c^n) ⊆ j_{nD}`. -/
theorem ellJet_pow_le (sc : Geo.EpaScale W σ) (s : OriginSeries ch) (c₀ : Fin m → ℂ) (n : ℕ)
    {x : AmbRing m} (hx : x ∈ Geo.centreIdealPt sc s c₀ ^ n) :
    ellJet s c₀ x ∈ jetIdeal W ((n * sc.D : ℕ) : ℚ) := by
  have h1 : ellJet s c₀ x ∈ Ideal.map (ellJet s c₀) (Geo.centreIdealPt sc s c₀ ^ n) :=
    Ideal.mem_map_of_mem _ hx
  rw [Ideal.map_pow] at h1
  have h2 := ideal_pow_le_rationalWeightedIdeal (jetWt W) (jetWt_nonneg W) _ (sc.D : ℚ)
    (map_centreIdealPt_le sc s c₀) n
  have h3 : ((n * sc.D : ℕ) : ℚ) = (n : ℚ) * (sc.D : ℚ) := by push_cast; ring
  rw [h3]
  exact h2 h1

/-! ### Surjectivity of `Φ_c` modulo `j_{nD}` -/

/-- `x` is the image of a polynomial modulo `j_H`. -/
def Reach (s : OriginSeries ch) (c₀ : Fin m → ℂ) (H : ℚ) (x : MvPowerSeries (Fin (m + 1)) ℂ) :
    Prop :=
  ∃ P : AmbRing m, ellJet s c₀ P - x ∈ jetIdeal W H

theorem reach_add {s : OriginSeries ch} {c₀ : Fin m → ℂ} {H : ℚ}
    {x y : MvPowerSeries (Fin (m + 1)) ℂ} (hx : Reach (W := W) s c₀ H x)
    (hy : Reach (W := W) s c₀ H y) : Reach (W := W) s c₀ H (x + y) := by
  obtain ⟨P, hP⟩ := hx
  obtain ⟨Q, hQ⟩ := hy
  refine ⟨P + Q, ?_⟩
  have : ellJet s c₀ (P + Q) - (x + y) = (ellJet s c₀ P - x) + (ellJet s c₀ Q - y) := by
    rw [map_add]; ring
  rw [this]
  exact add_mem hP hQ

theorem reach_mul {s : OriginSeries ch} {c₀ : Fin m → ℂ} {H : ℚ}
    {x y : MvPowerSeries (Fin (m + 1)) ℂ} (hx : Reach (W := W) s c₀ H x)
    (hy : Reach (W := W) s c₀ H y) : Reach (W := W) s c₀ H (x * y) := by
  obtain ⟨P, hP⟩ := hx
  obtain ⟨Q, hQ⟩ := hy
  refine ⟨P * Q, ?_⟩
  have : ellJet s c₀ (P * Q) - x * y =
      ellJet s c₀ P * (ellJet s c₀ Q - y) + y * (ellJet s c₀ P - x) := by
    rw [map_mul]; ring
  rw [this]
  exact add_mem (Ideal.mul_mem_left _ _ hQ) (Ideal.mul_mem_left _ _ hP)

theorem reach_C (s : OriginSeries ch) (c₀ : Fin m → ℂ) (H : ℚ) (a : ℂ) :
    Reach (W := W) s c₀ H (MvPowerSeries.C a) := by
  refine ⟨MvPolynomial.C a, ?_⟩
  rw [ellJet_C, sub_self]
  exact zero_mem _

theorem reach_X_zero (s : OriginSeries ch) (c₀ : Fin m → ℂ) (H : ℚ) :
    Reach (W := W) s c₀ H (MvPowerSeries.X (0 : Fin (m + 1))) := by
  refine ⟨tV, ?_⟩
  rw [ellJet_tV, sub_self]
  exact zero_mem _

theorem reach_X_succ (sc : Geo.EpaScale W σ) (s : OriginSeries ch) (c₀ : Fin m → ℂ) (n : ℕ)
    (i : Fin m) :
    Reach (W := W) s c₀ ((n * sc.D : ℕ) : ℚ) (MvPowerSeries.X i.succ) := by
  refine ⟨zV i - MvPolynomial.C (c₀ i) - Geo.truncL s (n * sc.a), ?_⟩
  rw [ellJet_zgen, add_sub_cancel_left]
  rw [mem_jetIdeal]
  intro d hd
  rw [coeff_liftSeries]
  split_ifs with ht
  · have hH : W.v₀ * ((n * sc.a : ℕ) : ℚ) = ((n * sc.D : ℕ) : ℚ) := by
      push_cast
      rw [← sc.a_eq]
      ring
    have hlt : d 0 < n * sc.a := d_zero_lt W hH hd
    rw [map_sub, coeff_LsTrunc, if_pos hlt, sub_self]
  · rfl

theorem reach_gen (sc : Geo.EpaScale W σ) (s : OriginSeries ch) (c₀ : Fin m → ℂ) (n : ℕ)
    (i : Fin (m + 1)) :
    Reach (W := W) s c₀ ((n * sc.D : ℕ) : ℚ) (MvPowerSeries.X i) := by
  induction i using Fin.cases with
  | zero => exact reach_X_zero s c₀ _
  | succ i => exact reach_X_succ sc s c₀ n i

theorem reach_poly (sc : Geo.EpaScale W σ) (s : OriginSeries ch) (c₀ : Fin m → ℂ) (n : ℕ)
    (p : MvPolynomial (Fin (m + 1)) ℂ) :
    Reach (W := W) s c₀ ((n * sc.D : ℕ) : ℚ) (p : MvPowerSeries (Fin (m + 1)) ℂ) := by
  induction p using MvPolynomial.induction_on with
  | C a =>
    rw [MvPolynomial.coe_C]
    exact reach_C s c₀ _ a
  | add p q hp hq =>
    rw [MvPolynomial.coe_add]
    exact reach_add hp hq
  | mul_X p i hp =>
    rw [MvPolynomial.coe_mul, MvPolynomial.coe_X]
    exact reach_mul hp (reach_gen sc s c₀ n i)

/-- Every series is congruent modulo `j_{nD}` to some `Φ_c(P)`. -/
theorem reach_all (sc : Geo.EpaScale W σ) (s : OriginSeries ch) (c₀ : Fin m → ℂ) (n : ℕ)
    (F : MvPowerSeries (Fin (m + 1)) ℂ) :
    ∃ P : AmbRing m, ellJet s c₀ P - F ∈ jetIdeal W ((n * sc.D : ℕ) : ℚ) := by
  classical
  let T : MvPolynomial (Fin (m + 1)) ℂ :=
    ∑ d ∈ Geo.monomials (jetWt W) ((n * sc.D : ℕ) : ℚ),
      MvPolynomial.monomial d (MvPowerSeries.coeff d F)
  obtain ⟨P, hP⟩ := reach_poly sc s c₀ n T
  refine ⟨P, ?_⟩
  have hdiff : ((T : MvPowerSeries (Fin (m + 1)) ℂ) - F) ∈ jetIdeal W ((n * sc.D : ℕ) : ℚ) := by
    rw [mem_jetIdeal]
    intro d hd
    rw [map_sub, MvPolynomial.coeff_coe]
    have hw : ∑ i, jetWt W i * (d i : ℚ) = Finsupp.weight (jetWt W) d := by
      rw [Finsupp.weight_eq_sum]
      exact Finset.sum_congr rfl fun i _ => by rw [nsmul_eq_mul, mul_comm]
    have hmem : d ∈ Geo.monomials (jetWt W) ((n * sc.D : ℕ) : ℚ) := by
      rw [Geo.mem_monomials (jetWt W) (Geo.jetWt_pos W), hw]
      exact hd.le
    simp only [T, MvPolynomial.coeff_sum, MvPolynomial.coeff_monomial, Finset.sum_ite_eq']
    rw [if_pos hmem, sub_self]
  have : ellJet s c₀ P - F = (ellJet s c₀ P - T) + (T - F) := by ring
  rw [this]
  exact add_mem hP hdiff

/-! ### Distinct centres: comaximal ideals -/

theorem centreIdealPt_isCoprime (sc : Geo.EpaScale W σ) (s : OriginSeries ch)
    {c₀ c₁ : Fin m → ℂ} (h : c₀ ≠ c₁) :
    IsCoprime (Geo.centreIdealPt sc s c₀) (Geo.centreIdealPt sc s c₁) := by
  obtain ⟨i, hi⟩ := Function.ne_iff.mp h
  have hx : (MvPolynomial.X i.succ.succ - MvPolynomial.C (c₀ i) : AmbRing m) ∈
      WeightedBezout.pointIdeal (Geo.cenPt c₀) := by
    rw [WeightedBezout.mem_pointIdeal]
    simp
  have hy : (MvPolynomial.X i.succ.succ - MvPolynomial.C (c₁ i) : AmbRing m) ∈
      WeightedBezout.pointIdeal (Geo.cenPt c₁) := by
    rw [WeightedBezout.mem_pointIdeal]
    simp
  have hmem : (MvPolynomial.C (c₁ i - c₀ i) : AmbRing m) ∈
      WeightedBezout.pointIdeal (Geo.cenPt c₀) ⊔ WeightedBezout.pointIdeal (Geo.cenPt c₁) := by
    have e : (MvPolynomial.C (c₁ i - c₀ i) : AmbRing m) =
        (MvPolynomial.X i.succ.succ - MvPolynomial.C (c₀ i)) -
          (MvPolynomial.X i.succ.succ - MvPolynomial.C (c₁ i)) := by
      rw [map_sub]; ring
    rw [e]
    exact Ideal.sub_mem _ (Ideal.mem_sup_left hx) (Ideal.mem_sup_right hy)
  have hunit : IsUnit (MvPolynomial.C (c₁ i - c₀ i) : AmbRing m) :=
    IsUnit.map MvPolynomial.C (isUnit_iff_ne_zero.mpr (sub_ne_zero.mpr (Ne.symm hi)))
  have hsup : WeightedBezout.pointIdeal (Geo.cenPt c₀) ⊔ WeightedBezout.pointIdeal (Geo.cenPt c₁) =
      ⊤ := Ideal.eq_top_of_isUnit_mem _ hmem hunit
  rw [Ideal.isCoprime_iff_sup_eq]
  apply Ideal.radical_eq_top.mp
  rw [Ideal.radical_sup, Geo.radical_centreIdealPt, Geo.radical_centreIdealPt, hsup,
    Ideal.radical_top]

/-! ### The packets of a family surjecting onto `ℂ[u,t,Z]/J^n` -/

/-- Row E09.11 (CM l.3506--3537): if the classes of `f a` exhaust `ℂ[u,t,Z]/J^n`, `J = ∏_j I_{c_j}`,
then the packets `Φ_{c_j}(f a)` modulo `j_{nD}` exhaust all families of packets. -/
theorem quotient_to_packets_surjective (sc : Geo.EpaScale W σ) (s : OriginSeries ch)
    (c : Fin K → Fin m → ℂ) (hc : Function.Injective c) (n : ℕ) {α : Type*} (f : α → AmbRing m)
    (hf : Function.Surjective fun a => Ideal.Quotient.mk ((Geo.centreIdealAff sc s c) ^ n) (f a)) :
    Function.Surjective fun a j =>
      rationalCoefficientPacket (jetWt W) ((n * sc.D : ℕ) : ℚ) (ellJet s (c j) (f a)) := by
  classical
  intro packets
  let F : Fin K → MvPowerSeries (Fin (m + 1)) ℂ := fun j d =>
    if hd : Finsupp.weight (jetWt W) d < ((n * sc.D : ℕ) : ℚ) then packets j ⟨d, hd⟩ else 0
  choose P hP using fun j => reach_all sc s (c j) n (F j)
  have hcop : Pairwise (Function.onFun IsCoprime fun j => (Geo.centreIdealPt sc s (c j)) ^ n) := by
    intro j k hjk
    exact (centreIdealPt_isCoprime sc s (fun h => hjk (hc h))).pow
  obtain ⟨Q, hQ⟩ := Ideal.exists_forall_sub_mem_ideal hcop P
  obtain ⟨a, ha⟩ := hf (Ideal.Quotient.mk _ Q)
  refine ⟨a, ?_⟩
  funext j d
  have h1 : f a - Q ∈ (Geo.centreIdealAff sc s c) ^ n := Ideal.Quotient.eq.mp ha
  have hle : Geo.centreIdealAff sc s c ≤ Geo.centreIdealPt sc s (c j) := by
    unfold Geo.centreIdealAff
    exact Ideal.prod_le_inf.trans (Finset.inf_le (Finset.mem_univ j))
  have h2 : f a - Q ∈ (Geo.centreIdealPt sc s (c j)) ^ n := Ideal.pow_right_mono hle n h1
  have h3 : f a - P j ∈ (Geo.centreIdealPt sc s (c j)) ^ n := by
    have := Ideal.add_mem _ h2 (hQ j)
    simpa using this
  have h4 := ellJet_pow_le sc s (c j) n h3
  have h5 : ellJet s (c j) (f a) - F j ∈ jetIdeal W ((n * sc.D : ℕ) : ℚ) := by
    have := add_mem h4 (hP j)
    rwa [map_sub, sub_add_sub_cancel] at this
  have hzero := (mem_jetIdeal.mp h5) d.val d.property
  rw [map_sub, sub_eq_zero] at hzero
  change MvPowerSeries.coeff d.val (ellJet s (c j) (f a)) = packets j d
  rw [hzero]
  change (if hd : Finsupp.weight (jetWt W) d.val < ((n * sc.D : ℕ) : ℚ) then
    packets j ⟨d.val, hd⟩ else 0) = packets j d
  rw [dif_pos d.property]

end Glue

end CatalanCore.Elliptic.EPA
