module

public import CatalanCore.Elliptic.EPA.Ambient
public import CatalanCore.Elliptic.EPA.NoPrimitive.Finite
public import Mathlib.FieldTheory.IsAlgClosed.Basic
public import Mathlib.Analysis.Complex.Polynomial.Basic
public import Mathlib.FieldTheory.KummerPolynomial
public import Mathlib.RingTheory.Polynomial.GaussLemma
public import Mathlib.RingTheory.Polynomial.UniqueFactorization
public import Mathlib.RingTheory.Ideal.GoingUp
public import Mathlib.Algebra.MvPolynomial.Equiv
public import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# Quartic facts of the rigidity step (row E09.5b)

Labels refer to the proof design §5 E09.5b (CM l.1588-1641) and §A5.

Let `F = Fc ch = U + 3aU² + (3a²+A)U³ + f(a)U⁴ ∈ ℂ[U]` be the quartic of the chart and
`relation ch = t² − F(u) ∈ ℂ[u,t,Z]`.

* `Fc_squarefree`, `Fc_natDegree` (`= 4`), `two_le_natDegree_Fc`: the two hypotheses of the
  no-primitive theorems (`no_ratfunc_solution`, `no_finite_primitive`,
  `isAlgebraic_of_quartic_differential`), together with the form after base change to any field
  `C ⊇ ℂ` (`Fc_map_squarefree`, `Fc_map_natDegree`), which is needed when the proof passes to a
  field generated by a transcendence basis (design §A5).
* `no_ratfunc_solution_Fc`: `no_ratfunc_solution` for the quartic of the chart.
* `relation_isPrime`: `(relation ch)` is a prime ideal of `ℂ[u,t,Z]` (CM l.1618). Proof: swap
  `u ↔ t`, view the relation as `T² − g` over `ℂ[u,Z]` with `g = F(u)`; it is monic, so by Gauss
  it is irreducible iff `g` is not a square in the fraction field, hence (integrally closed) not a
  square in `ℂ[u,Z]`; setting `Z = 0` a square would make `F` a square in `ℂ[u]`, contradicting
  `Fc_squarefree` and `natDegree F = 4`.
* `tZHom_isIntegral`: the quotient `ℂ[u,t,Z]/(relation)` is integral over `ℂ[t,Z]`
  (embedded by `Z ↦ Z`, `t ↦ t`): `u` satisfies the monic equation `u⁴ + … = 0` obtained by dividing
  `F(u) − t²` by `f(a) ≠ 0`; also `tZHom_finite`.
* `contract_ne_bot`: a prime `Q` strictly containing `(relation ch)` meets `ℂ[t,Z]` nontrivially
  (CM l.1635).
-/

@[expose] public section

namespace CatalanCore.Elliptic.EPA

open CatalanCore.Elliptic Polynomial

variable {m : ℕ}

/-! ### The quartic -/

theorem Fc_eq (ch : OriginChart) : Fc ch = X + C (3 * (ch.a : ℂ)) * X ^ 2
    + C (3 * (ch.a : ℂ) ^ 2 + ch.A) * X ^ 3
    + C ((ch.a : ℂ) ^ 3 + ch.A * ch.a + ch.B) * X ^ 4 := by
  simp only [Fc, OriginChart.F, Polynomial.map_add, Polynomial.map_mul, Polynomial.map_X,
    Polynomial.map_C, Polynomial.map_pow, Int.coe_castRingHom]
  push_cast
  rfl

theorem eval_Fc (ch : OriginChart) (x : ℂ) :
    (Fc ch).eval x = x + 3 * ch.a * x ^ 2 + (3 * ch.a ^ 2 + ch.A) * x ^ 3
      + (ch.a ^ 3 + ch.A * ch.a + ch.B) * x ^ 4 := by
  rw [Fc_eq]; simp

theorem eval_derivative_Fc (ch : OriginChart) (x : ℂ) :
    (derivative (Fc ch)).eval x = 1 + 6 * ch.a * x + 3 * (3 * ch.a ^ 2 + ch.A) * x ^ 2
      + 4 * (ch.a ^ 3 + ch.A * ch.a + ch.B) * x ^ 3 := by
  rw [Fc_eq]
  simp only [derivative_add, derivative_X, derivative_C_mul_X_pow, eval_add, eval_mul, eval_C,
    eval_pow, eval_X, eval_one]
  push_cast
  ring

theorem coeff_four_Fc (ch : OriginChart) :
    (Fc ch).coeff 4 = (ch.a : ℂ) ^ 3 + ch.A * ch.a + ch.B := by
  rw [Fc_eq]
  simp only [Polynomial.coeff_add, Polynomial.coeff_X, Polynomial.coeff_C_mul,
    Polynomial.coeff_X_pow]
  norm_num

theorem fa_ne_complex (ch : OriginChart) : ((ch.a : ℂ) ^ 3 + ch.A * ch.a + ch.B) ≠ 0 := by
  have := ch.fa_ne
  exact_mod_cast this

theorem disc_ne_complex (ch : OriginChart) : (4 * (ch.A : ℂ) ^ 3 + 27 * (ch.B : ℂ) ^ 2) ≠ 0 := by
  have := ch.disc_ne
  exact_mod_cast this

/-- `F` has degree exactly `4` (`f(a) ≠ 0`). -/
theorem Fc_natDegree (ch : OriginChart) : (Fc ch).natDegree = 4 := by
  refine Polynomial.natDegree_eq_of_le_of_coeff_ne_zero (natDegree_Fc_le ch) ?_
  rw [coeff_four_Fc]
  exact fa_ne_complex ch

theorem two_le_natDegree_Fc (ch : OriginChart) : 2 ≤ (Fc ch).natDegree := by
  rw [Fc_natDegree]; norm_num

/-- `F` and `F'` have no common root (CM l.1596-1607): `F(0) = 0`, `F'(0) = 1`; for `r ≠ 0`,
`F(r) = r⁴ h(a + 1/r)` and `F'(r) = 4r³ h(a + 1/r) − r² h'(a + 1/r)` with `h = x³ + Ax + B`, so a
common root gives a common root of `h, h'`, i.e. `4A³ + 27B² = 0`. -/
theorem Fc_separable (ch : OriginChart) : (Fc ch).Separable := by
  unfold Polynomial.Separable
  rw [Polynomial.isCoprime_iff_aeval_ne_zero_of_isAlgClosed ℂ ℂ]
  intro r
  simp only [Polynomial.aeval_def, Polynomial.eval₂_eq_eval_map, Algebra.algebraMap_self, Polynomial.map_id]
  rw [eval_Fc, eval_derivative_Fc]
  by_cases hr : r = 0
  · right; subst hr; simp
  · by_contra hcon
    push Not at hcon
    obtain ⟨h1, h2⟩ := hcon
    set a : ℂ := (ch.a : ℂ)
    set A : ℂ := (ch.A : ℂ)
    set B : ℂ := (ch.B : ℂ)
    set s : ℂ := a + r⁻¹ with hs
    have hF : r + 3 * a * r ^ 2 + (3 * a ^ 2 + A) * r ^ 3 + (a ^ 3 + A * a + B) * r ^ 4
        = r ^ 4 * (s ^ 3 + A * s + B) := by
      rw [hs]; field_simp; ring
    have hF' : 1 + 6 * a * r + 3 * (3 * a ^ 2 + A) * r ^ 2 + 4 * (a ^ 3 + A * a + B) * r ^ 3
        = 4 * r ^ 3 * (s ^ 3 + A * s + B) - r ^ 2 * (3 * s ^ 2 + A) := by
      rw [hs]; field_simp; ring
    have hr4 : r ^ 4 ≠ 0 := pow_ne_zero _ hr
    have hr2 : r ^ 2 ≠ 0 := pow_ne_zero _ hr
    rw [hF] at h1
    have hh : s ^ 3 + A * s + B = 0 := by
      rcases mul_eq_zero.mp h1 with h | h
      · exact absurd h hr4
      · exact h
    rw [hF', hh] at h2
    have hh' : 3 * s ^ 2 + A = 0 := by
      have : r ^ 2 * (3 * s ^ 2 + A) = 0 := by linear_combination -h2
      rcases mul_eq_zero.mp this with h | h
      · exact absurd h hr2
      · exact h
    apply disc_ne_complex ch
    linear_combination (4 * A ^ 2 + 3 * s * (2 * A * s - 3 * B)) * hh'
      - 9 * (2 * A * s - 3 * B) * hh

theorem Fc_squarefree (ch : OriginChart) : Squarefree (Fc ch) :=
  (Fc_separable ch).squarefree

/-- Base change to a field `C ⊇ ℂ` of characteristic zero keeps the two hypotheses
(design §A5). -/
theorem Fc_map_squarefree (ch : OriginChart) (C : Type*) [Field C] [Algebra ℂ C] :
    Squarefree ((Fc ch).map (algebraMap ℂ C)) :=
  ((Fc_separable ch).map).squarefree

theorem Fc_map_natDegree (ch : OriginChart) (C : Type*) [Field C] [Algebra ℂ C] :
    ((Fc ch).map (algebraMap ℂ C)).natDegree = 4 := by
  rw [Polynomial.natDegree_map, Fc_natDegree]

theorem two_le_natDegree_Fc_map (ch : OriginChart) (C : Type*) [Field C] [Algebra ℂ C] :
    2 ≤ ((Fc ch).map (algebraMap ℂ C)).natDegree := by
  rw [Fc_map_natDegree]; norm_num

/-- `no_ratfunc_solution` for the quartic of the chart, over any field `C ⊇ ℂ`. -/
theorem no_ratfunc_solution_Fc (ch : OriginChart) (C : Type*) [Field C] [Algebra ℂ C]
    [CharZero C] (r : RatFunc C) :
    2 * algebraMap C[X] (RatFunc C) ((Fc ch).map (algebraMap ℂ C)) * CatalanCore.Elliptic.EPA.NoPrimitive.derivationX C r
      + algebraMap C[X] (RatFunc C) (derivative ((Fc ch).map (algebraMap ℂ C))) * r ≠ 1 :=
  no_ratfunc_solution _ (Fc_map_squarefree ch C) (two_le_natDegree_Fc_map ch C) r


/-! ### The relation is prime -/

section Prime

/-- Swap `u ↔ t`, then view `ℂ[t,u,Z]` as polynomials in `t` over `ℂ[u,Z]`. -/
noncomputable def splitT : AmbRing m ≃ₐ[ℂ] Polynomial (MvPolynomial (Fin (m + 1)) ℂ) :=
  (MvPolynomial.renameEquiv ℂ (Equiv.swap (0 : Fin (m + 2)) 1)).trans
    (MvPolynomial.finSuccEquiv ℂ (m + 1))

theorem splitT_relation (ch : OriginChart) :
    splitT (relation ch : AmbRing m) =
      Polynomial.X ^ 2 - Polynomial.C (Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin (m + 1)) ℂ)
        (Fc ch)) := by
  have ht : splitT (tV : AmbRing m) = Polynomial.X := by
    simp [splitT, tV, MvPolynomial.renameEquiv_apply, MvPolynomial.rename_X,
      MvPolynomial.finSuccEquiv_X_zero]
  have hu : splitT (uV : AmbRing m) = Polynomial.C (MvPolynomial.X 0) := by
    have hs : (Equiv.swap (0 : Fin (m + 2)) 1) 0 = Fin.succ (0 : Fin (m + 1)) := by
      simp
    show MvPolynomial.finSuccEquiv ℂ (m + 1) (MvPolynomial.rename (Equiv.swap (0 : Fin (m + 2)) 1)
      (MvPolynomial.X 0)) = _
    rw [MvPolynomial.rename_X, hs, MvPolynomial.finSuccEquiv_X_succ]
  unfold relation
  rw [map_sub, map_pow, ht]
  congr 1
  have h1 : splitT (Polynomial.aeval (uV : AmbRing m) (Fc ch)) =
      Polynomial.aeval (splitT (uV : AmbRing m)) (Fc ch) :=
    (Polynomial.aeval_algHom_apply (splitT : AmbRing m ≃ₐ[ℂ] _).toAlgHom uV (Fc ch)).symm
  rw [h1, hu]
  exact Polynomial.aeval_algebraMap_apply (B := Polynomial (MvPolynomial (Fin (m + 1)) ℂ))
    (MvPolynomial.X 0 : MvPolynomial (Fin (m + 1)) ℂ) (Fc ch)

theorem irreducible_X_sq_sub_C (ch : OriginChart) :
    Irreducible (Polynomial.X ^ 2 - Polynomial.C (Polynomial.aeval (MvPolynomial.X 0 :
      MvPolynomial (Fin (m + 1)) ℂ) (Fc ch)) : Polynomial (MvPolynomial (Fin (m + 1)) ℂ)) := by
  set R := MvPolynomial (Fin (m + 1)) ℂ
  set g : R := Polynomial.aeval (MvPolynomial.X 0) (Fc ch)
  have hmonic : (Polynomial.X ^ 2 - Polynomial.C g : R[X]).Monic :=
    Polynomial.monic_X_pow_sub_C g (by norm_num)
  rw [hmonic.irreducible_iff_irreducible_map_fraction_map (K := FractionRing R)]
  simp only [Polynomial.map_sub, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_C]
  apply X_pow_sub_C_irreducible_of_prime Nat.prime_two
  intro b hb
  have hint : IsIntegral R b :=
    ⟨Polynomial.X ^ 2 - Polynomial.C g, hmonic, by simp [Polynomial.eval₂_sub, hb]⟩
  obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
  have hyg : y ^ 2 = g := by
    apply IsFractionRing.injective R (FractionRing R)
    rw [map_pow, hy, hb]
  let ψ : R →ₐ[ℂ] ℂ[X] :=
    MvPolynomial.aeval (fun i : Fin (m + 1) => if i = 0 then Polynomial.X else 0)
  have hψ : ψ g = Fc ch := by
    have h0 : ψ (MvPolynomial.X 0) = Polynomial.X := by
      show MvPolynomial.aeval _ (MvPolynomial.X 0) = _
      rw [MvPolynomial.aeval_X]; simp
    simp only [g]
    rw [← Polynomial.aeval_algHom_apply, h0, Polynomial.aeval_X_left_apply]
  have hFc : Fc ch = ψ y * ψ y := by rw [← hψ, ← hyg, sq, map_mul]
  have hunit : IsUnit (ψ y) := Fc_squarefree ch (ψ y) ⟨1, by rw [mul_one]; exact hFc⟩
  have h0 : (Fc ch).natDegree = 0 := by
    rw [hFc]
    exact Polynomial.natDegree_eq_zero_of_isUnit (hunit.mul hunit)
  rw [Fc_natDegree] at h0
  exact absurd h0 (by norm_num)

theorem relation_irreducible (ch : OriginChart) : Irreducible (relation ch : AmbRing m) := by
  have h := irreducible_X_sq_sub_C (m := m) ch
  rw [← splitT_relation] at h
  exact (MulEquiv.irreducible_iff (splitT (m := m))).mp h

theorem relation_isPrime (ch : OriginChart) :
    (Ideal.span {relation ch} : Ideal (AmbRing m)).IsPrime :=
  (Ideal.span_singleton_prime (relation_irreducible ch).ne_zero).mpr
    (relation_irreducible ch).prime

end Prime

/-! ### Integrality over `ℂ[t,Z]` and the contraction of primes -/

section Integral

/-- The embedding `ℂ[t,Z] → ℂ[u,t,Z]/(relation)` (`t ↦ t`, `Z_i ↦ Z_i`). -/
noncomputable def tZHom (ch : OriginChart) (m : ℕ) :
    MvPolynomial (Fin (m + 1)) ℂ →+* AmbRing m ⧸ Ideal.span {relation ch} :=
  (Ideal.Quotient.mk _).comp
    (MvPolynomial.rename (Fin.succ : Fin (m + 1) → Fin (m + 2)) :
      MvPolynomial (Fin (m + 1)) ℂ →ₐ[ℂ] AmbRing m).toRingHom

theorem relation_eq (ch : OriginChart) : (relation ch : AmbRing m) =
    tV ^ 2 - (uV + MvPolynomial.C (3 * (ch.a : ℂ)) * uV ^ 2 + MvPolynomial.C (3 * (ch.a : ℂ) ^ 2 + ch.A) * uV ^ 3
      + MvPolynomial.C ((ch.a : ℂ) ^ 3 + ch.A * ch.a + ch.B) * uV ^ 4) := by
  unfold relation
  rw [Fc_eq]
  simp [uV]

theorem tZHom_isIntegral (ch : OriginChart) : (tZHom ch m).IsIntegral := by
  have := relation_isPrime (m := m) ch
  letI : Algebra (MvPolynomial (Fin (m + 1)) ℂ) (AmbRing m ⧸ Ideal.span {relation ch}) :=
    (tZHom ch m).toAlgebra
  have hal : ∀ r : MvPolynomial (Fin (m + 1)) ℂ,
      algebraMap (MvPolynomial (Fin (m + 1)) ℂ) (AmbRing m ⧸ Ideal.span {relation ch}) r =
        Ideal.Quotient.mk _ (MvPolynomial.rename (Fin.succ : Fin (m + 1) → Fin (m + 2)) r) :=
    fun r => rfl
  have hk0 := fa_ne_complex ch
  -- the equation of `u`
  set k : ℂ := (ch.a : ℂ) ^ 3 + ch.A * ch.a + ch.B with hk
  have hu : IsIntegral (MvPolynomial (Fin (m + 1)) ℂ)
      (Ideal.Quotient.mk (Ideal.span {relation ch}) (uV : AmbRing m)) := by
    let P : Polynomial (MvPolynomial (Fin (m + 1)) ℂ) :=
      Polynomial.X ^ 4 + Polynomial.C (MvPolynomial.C (k⁻¹ * (3 * (ch.a : ℂ) ^ 2 + ch.A))) *
        Polynomial.X ^ 3 + Polynomial.C (MvPolynomial.C (k⁻¹ * (3 * (ch.a : ℂ)))) *
        Polynomial.X ^ 2 + Polynomial.C (MvPolynomial.C k⁻¹) * Polynomial.X
        - Polynomial.C (MvPolynomial.C k⁻¹ * MvPolynomial.X 0 ^ 2)
    have hmon : P.Monic := by
      simp only [P, sub_eq_add_neg, ← Polynomial.C_neg]
      monicity!
    refine ⟨P, hmon, ?_⟩
    have hrel : Ideal.Quotient.mk (Ideal.span {relation ch}) (relation ch : AmbRing m) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
    have hkC : (MvPolynomial.C k⁻¹ * MvPolynomial.C k : AmbRing m) = 1 := by
      rw [← MvPolynomial.C_mul, inv_mul_cancel₀ hk0, MvPolynomial.C_1]
    have key : (uV ^ 4 + MvPolynomial.C (k⁻¹ * (3 * (ch.a : ℂ) ^ 2 + ch.A)) * uV ^ 3
        + MvPolynomial.C (k⁻¹ * (3 * (ch.a : ℂ))) * uV ^ 2 + MvPolynomial.C k⁻¹ * uV - MvPolynomial.C k⁻¹ * tV ^ 2 : AmbRing m)
        = - (MvPolynomial.C k⁻¹ * relation ch) := by
      rw [relation_eq]
      simp only [MvPolynomial.C_mul]
      linear_combination (-(uV : AmbRing m) ^ 4) * hkC
    have hR : Ideal.Quotient.mk (Ideal.span {relation ch})
        (-(MvPolynomial.C k⁻¹ * relation ch) : AmbRing m) = 0 := by
      rw [map_neg, map_mul, hrel, mul_zero, neg_zero]
    have hmk := congrArg (Ideal.Quotient.mk (Ideal.span {relation ch})) key
    rw [hR] at hmk
    simp only [P, Polynomial.eval₂_add, Polynomial.eval₂_sub, Polynomial.eval₂_mul,
      Polynomial.eval₂_C, Polynomial.eval₂_X, Polynomial.eval₂_pow, hal, MvPolynomial.rename_C,
      MvPolynomial.rename_X, Fin.succ_zero_eq_one, map_mul, map_pow]
    simp only [map_add, map_sub, map_mul, map_pow] at hmk
    simpa [tV] using hmk
  have hX : ∀ i : Fin (m + 2), IsIntegral (MvPolynomial (Fin (m + 1)) ℂ)
      (Ideal.Quotient.mk (Ideal.span {relation ch}) (MvPolynomial.X i : AmbRing m)) := by
    intro i
    refine Fin.cases ?_ (fun j => ?_) i
    · exact hu
    · have : Ideal.Quotient.mk (Ideal.span {relation ch}) (MvPolynomial.X j.succ : AmbRing m) =
          algebraMap (MvPolynomial (Fin (m + 1)) ℂ) (AmbRing m ⧸ Ideal.span {relation ch})
            (MvPolynomial.X j) := by rw [hal, MvPolynomial.rename_X]
      rw [this]
      exact isIntegral_algebraMap
  have key : ∀ x : AmbRing m ⧸ Ideal.span {relation ch},
      IsIntegral (MvPolynomial (Fin (m + 1)) ℂ) x := by
    intro x
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
    induction p using MvPolynomial.induction_on with
    | C c =>
      have : Ideal.Quotient.mk (Ideal.span {relation ch}) (MvPolynomial.C c : AmbRing m) =
          algebraMap (MvPolynomial (Fin (m + 1)) ℂ) (AmbRing m ⧸ Ideal.span {relation ch})
            (MvPolynomial.C c) := by rw [hal, MvPolynomial.rename_C]
      rw [this]
      exact isIntegral_algebraMap
    | add p q hp hq => rw [map_add]; exact hp.add hq
    | mul_X p i hp => rw [map_mul]; exact hp.mul (hX i)
  exact key

theorem tZHom_finiteType (ch : OriginChart) : (tZHom ch m).FiniteType := by
  letI : Algebra (MvPolynomial (Fin (m + 1)) ℂ) (AmbRing m ⧸ Ideal.span {relation ch}) :=
    (tZHom ch m).toAlgebra
  have hal : ∀ r : MvPolynomial (Fin (m + 1)) ℂ,
      algebraMap (MvPolynomial (Fin (m + 1)) ℂ) (AmbRing m ⧸ Ideal.span {relation ch}) r =
        Ideal.Quotient.mk _ (MvPolynomial.rename (Fin.succ : Fin (m + 1) → Fin (m + 2)) r) :=
    fun r => rfl
  refine ⟨⟨{Ideal.Quotient.mk (Ideal.span {relation ch}) (uV : AmbRing m)}, ?_⟩⟩
  rw [eq_top_iff]
  rintro x -
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
  induction p using MvPolynomial.induction_on with
  | C c =>
    have : Ideal.Quotient.mk (Ideal.span {relation ch}) (MvPolynomial.C c : AmbRing m) =
        algebraMap (MvPolynomial (Fin (m + 1)) ℂ) (AmbRing m ⧸ Ideal.span {relation ch})
          (MvPolynomial.C c) := by rw [hal, MvPolynomial.rename_C]
    rw [this]
    exact Subalgebra.algebraMap_mem _ _
  | add p q hp hq => rw [map_add]; exact Subalgebra.add_mem _ hp hq
  | mul_X p i hp =>
    rw [map_mul]
    refine Subalgebra.mul_mem _ hp ?_
    refine Fin.cases ?_ (fun j => ?_) i
    · exact Algebra.subset_adjoin (by simp only [Finset.coe_singleton, Set.mem_singleton_iff]; rfl)
    · have : Ideal.Quotient.mk (Ideal.span {relation ch}) (MvPolynomial.X j.succ : AmbRing m) =
          algebraMap (MvPolynomial (Fin (m + 1)) ℂ) (AmbRing m ⧸ Ideal.span {relation ch})
            (MvPolynomial.X j) := by rw [hal, MvPolynomial.rename_X]
      rw [this]
      exact Subalgebra.algebraMap_mem _ _

/-- `ℂ[u,t,Z]/(relation)` is a finite module over `ℂ[t,Z]`. -/
theorem tZHom_finite (ch : OriginChart) : (tZHom ch m).Finite :=
  (tZHom_isIntegral ch).to_finite (tZHom_finiteType ch)

/-- **`contract_ne_bot`** (CM l.1635): a prime strictly above `(relation ch)` meets `ℂ[t,Z]`
nontrivially. -/
theorem contract_ne_bot (ch : OriginChart) (Q : Ideal (AmbRing m))
    (hQ : Ideal.span {relation ch} < Q) :
    Q.comap (MvPolynomial.rename (Fin.succ : Fin (m + 1) → Fin (m + 2)) :
      MvPolynomial (Fin (m + 1)) ℂ →ₐ[ℂ] AmbRing m) ≠ ⊥ := by
  have := relation_isPrime (m := m) ch
  letI : Algebra (MvPolynomial (Fin (m + 1)) ℂ) (AmbRing m ⧸ Ideal.span {relation ch}) :=
    (tZHom ch m).toAlgebra
  have : IsDomain (AmbRing m ⧸ Ideal.span {relation ch}) := Ideal.Quotient.isDomain _
  obtain ⟨q, hqQ, hqn⟩ := IsConcreteLE.exists_of_lt hQ
  have hx0 : Ideal.Quotient.mk (Ideal.span {relation ch}) q ≠ 0 := fun h =>
    hqn (Ideal.Quotient.eq_zero_iff_mem.mp h)
  have hxI : Ideal.Quotient.mk (Ideal.span {relation ch}) q ∈
      Q.map (Ideal.Quotient.mk (Ideal.span {relation ch})) := Ideal.mem_map_of_mem _ hqQ
  have hint : IsIntegral (MvPolynomial (Fin (m + 1)) ℂ)
      (Ideal.Quotient.mk (Ideal.span {relation ch}) q) := tZHom_isIntegral ch _
  have hne := Ideal.under_ne_bot_of_integral_mem hx0 hxI hint
  intro hbot
  apply hne
  rw [eq_bot_iff]
  intro r hr
  have hr' : algebraMap (MvPolynomial (Fin (m + 1)) ℂ) (AmbRing m ⧸ Ideal.span {relation ch}) r ∈
      Q.map (Ideal.Quotient.mk (Ideal.span {relation ch})) := hr
  obtain ⟨y, hyQ, hy⟩ := (Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective).mp hr'
  have hdiff : MvPolynomial.rename (Fin.succ : Fin (m + 1) → Fin (m + 2)) r - y ∈
      Ideal.span {relation ch} := by
    rw [← Ideal.Quotient.eq]
    exact hy.symm
  have hmem : MvPolynomial.rename (Fin.succ : Fin (m + 1) → Fin (m + 2)) r ∈ Q := by
    have := Q.add_mem (hQ.le hdiff) hyQ
    simpa using this
  have : r ∈ Q.comap (MvPolynomial.rename (Fin.succ : Fin (m + 1) → Fin (m + 2)) :
      MvPolynomial (Fin (m + 1)) ℂ →ₐ[ℂ] AmbRing m) := hmem
  rw [hbot] at this
  exact this

end Integral

end CatalanCore.Elliptic.EPA
